#!/bin/sh
# ============================================================
# post-commit — Atlas git hook (portable, versionado)
# Registra en inbox/ un evento 'commit' tras cada commit.
# Se activa via:  git config core.hooksPath hooks
#
# NO bloquea el commit: cualquier fallo aqui no aborta git.
# Los datos viajan por env vars (asignacion literal, robusta a
# comillas/caracteres raros del mensaje), no por argv.
# ============================================================
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
py="$root/.venv/Scripts/python.exe"
[ -x "$py" ] || exit 0

hash_="$(git rev-parse --short HEAD 2>/dev/null)"
msg="$(git log -1 --format=%s 2>/dev/null)"
files="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | tr '\n' ',' | sed 's/,$//')"

ATLAS_GIT_PROJECT="agente_ia" \
ATLAS_GIT_HASH="$hash_" \
ATLAS_GIT_MSG="$msg" \
ATLAS_GIT_FILES="$files" \
"$py" "$root/mcp_memory_server.py" --hook-env >/dev/null 2>&1

exit 0