{
  // Plantilla portable de config de opencode para el ecosistema Atlas.
  // Copiar a %USERPROFILE%\.config\opencode\opencode.jsonc y reemplazar:
  //   %%PYTHON_BIN%%      → ruta al python.exe del venv (con \ escapadas, ej: C:\\Users\\TU\\venv\\Scripts\\python.exe)
  //   %%PROJECT_ROOT%%    → raiz del proyecto Atlas (ej: D:\\Dev\\Agente_IA)
  //   %%MCP_WINDOWS_AI%%  → raiz del repo mcp-windows-ai (opcional, para MCP corel/windows/playwright-visual)
  // El script setup.ps1 hace esta sustitución automaticamente.
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "apiKey": "{env:OMNIROUTE_API_KEY}",
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "auto/best-coding": { "name": "auto/best-coding (OmniRoute)" },
        "auto/best-reasoning": { "name": "auto/best-reasoning (OmniRoute)" },
        "auto/best-vision": { "name": "auto/best-vision (OmniRoute)" },
        "auto/best-fast": { "name": "auto/best-fast (OmniRoute)" },
        "auto/best-chat": { "name": "auto/best-chat (OmniRoute)" },
        "oc/north-mini-code-free": { "name": "north-mini-code-free (OmniRoute, gratis)" },
        "oc/deepseek-v4-flash-free": { "name": "deepseek-v4-flash-free (OmniRoute, gratis)" },
        "opencode-go/deepseek-v4-flash": { "name": "deepseek-v4-flash (OmniRoute)" }
      }
    },
    "ninerouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://localhost:4000/v1"
      },
      "models": {
        "groq/llama-3.3-70b-versatile": { "name": "Llama 3.3 70B (9Router/Groq)" },
        "gemini/gemini-3.6-flash": { "name": "Gemini 3.6 Flash (9Router)" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:1.5b": { "name": "qwen2.5:1.5b (local, offline L0/L1)" }
      }
    }
  },
  "model": "omniroute/auto/best-coding",
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%PROJECT_ROOT%%\\mcp_memory_server.py"],
      "environment": {
        "MEMORY_ROOT": "%%PROJECT_ROOT%%\\memory_data"
      },
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "-m", "mcp_server_git"],
      "enabled": true
    },
    "atlas-search": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%PROJECT_ROOT%%\\atlas_search.py"],
      "environment": {
        "MEMORY_ROOT": "%%PROJECT_ROOT%%\\memory_data"
      },
      "enabled": true
    },
    "atlas-guardian": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%PROJECT_ROOT%%\\atlas_guardian.py"],
      "environment": {
        "MEMORY_ROOT": "%%PROJECT_ROOT%%\\memory_data"
      },
      "enabled": true
    },
    "atlas-foco": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%PROJECT_ROOT%%\\atlas_foco.py"],
      "environment": {
        "MEMORY_ROOT": "%%PROJECT_ROOT%%\\memory_data"
      },
      "enabled": true
    },
    "atlas-health": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%PROJECT_ROOT%%\\atlas_health.py"],
      "environment": {
        "MEMORY_ROOT": "%%PROJECT_ROOT%%\\memory_data"
      },
      "enabled": true
    },
    "atlas-orchestrator": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%PROJECT_ROOT%%\\atlas_orchestrator.py"],
      "environment": {
        "MEMORY_ROOT": "%%PROJECT_ROOT%%\\memory_data"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "ollama": {
      "type": "local",
      "command": ["npx", "-y", "ollama-mcp-server"],
      "enabled": false
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true
    },
    "corel-draw": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%MCP_WINDOWS_AI%%\\mcp_corel_server.py"],
      "enabled": true
    },
    "windows": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%MCP_WINDOWS_AI%%\\mcp_windows_server.py"],
      "enabled": true
    },
    "playwright-visual": {
      "type": "local",
      "command": ["%%PYTHON_BIN%%", "%%MCP_WINDOWS_AI%%\\mcp_playwright_visual_server.py"],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=TU_PROJECT_REF&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      // Deshabilitado por defecto: requiere project_ref real de Supabase.
      // Rellena el project_ref y pon "enabled": true si lo necesitas.
      "enabled": false
    }
  }
}
