# Plantilla de variables de entorno para el ecosistema Atlas.
# Copia a .env si necesitas sobrescribir valores por defecto, o exporta las
# variables en tu sesion. NUNCA commitees .env con valores reales.

# Proveedor omniroute (modelos auto/*). La clave real vive en %APPDATA%\omniroute\.env
# o como variable de entorno. En opencode.json el provider usa {env:OMNIROUTE_API_KEY}.
OMNIROUTE_API_KEY=

# Raiz del vault de memoria. Por defecto es <raiz del repo>\memory_data.
# Solo necesitas definirla si mueves el vault a otra ubicacion.
# MEMORY_ROOT=

# Proyecto por defecto para el servidor de memoria (opcional).
# MEMORY_PROJECT=
